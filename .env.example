EDU_BIND_IP=127.0.0.1
EDU_HTTP_PORT=18088
# Renseigné automatiquement par scripts/configure_ollama_host.py après création du réseau.
# EDU_OLLAMA_HOST_IP=passerelle_du_backend
EDU_CLOUD_MODEL=gpt-oss:120b-cloud
EDU_EMBEDDING_MODEL=educapilote-embeddinggemma:v1
EDU_AI_DAILY_CALLS=200
# Pour l'overlay TLS seulement : certificat valide, clé lisible par UID 101.
# EDU_TLS_DIR=/chemin/absolu/certificats
# EDU_TLS_BIND_IP=0.0.0.0
# EDU_TLS_PORT=18443

EDU_WEB_ORIGINS=http://localhost:18088,http://127.0.0.1:18088
EDU_COOKIE_SECURE=false
# Overlay TLS : EDU_PUBLIC_ORIGIN=https://votre-domaine

# UUID de l’établissement de ce site, uniquement utilisé côté serveur.
EDU_LOGIN_SCHOOL_ID=
