# Copy required values into .env on the VPS; never commit operational .env files.
EDU_DOMAIN=
EDU_ACME_EMAIL=
# Staging first; only after successful reachability testing switch to:
# https://acme-v02.api.letsencrypt.org/directory
EDU_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
EDU_HTTPS_BIND_IP=0.0.0.0
EDU_HTTPS_PORT=443
EDU_OLLAMA_HOST_IP=10.200.2.1
EDU_OLLAMA_URL=http://ollama-host:11434
# No invented price. Both values required for an estimated EUR series.
EDU_AI_INPUT_EUR_PER_MILLION=
EDU_AI_OUTPUT_EUR_PER_MILLION=
# Only with --profile local-ollama and an available NVIDIA device.
EDU_GPU_ID=0
