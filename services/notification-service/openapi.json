  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "Event": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1,
            "title": "Label"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "date"
        ],
        "title": "Event"
      },
      "GenerationInput": {
        "properties": {
          "template": {
            "type": "string",
            "enum": [
              "arithmetic",
              "agreement",
              "chronology"
            ],
            "title": "Template"
          },
          "kind": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "fill_blanks",
              "short_text",
              "step_problem",
              "ordering",
              "timeline"
            ],
            "title": "Kind"
          },
          "competency_id": {
            "type": "string",
            "format": "uuid",
            "title": "Competency Id"
          },
          "source_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Source Ids"
          },
          "seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Events",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "template",
          "kind",
          "competency_id",
          "source_ids",
          "seed"
        ],
        "title": "GenerationInput"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "module": {
            "type": "string",
            "const": "infrastructure",
            "title": "Module",
            "default": "infrastructure"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "JobInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "weekly_reports",
              "difficulty_alerts",
              "exercise_batch",
              "privacy_purge"
            ],
            "title": "Kind"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "title": "Idempotency Key"
          },
          "generations": {
            "items": {
              "$ref": "#/components/schemas/GenerationInput"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Generations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "idempotency_key"
        ],
        "title": "JobInput"
      },
      "JobView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "attempts",
          "result",
          "error_code"
        ],
        "title": "JobView"
      },
      "Notice": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "student_id": {
            "type": "string",
            "format": "uuid",
            "title": "Student Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "period": {
            "type": "string",
            "format": "date",
            "title": "Period"
          },
          "body": {
            "additionalProperties": true,
            "type": "object",
            "title": "Body"
          },
          "read_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Read At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "student_id",
          "kind",
          "period",
          "body",
          "read_at"
        ],
        "title": "Notice"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "module": {
            "type": "string",
            "const": "infrastructure",
            "title": "Module",
            "default": "infrastructure"
          },
          "postgres": {
            "type": "boolean",
            "title": "Postgres"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service",
          "postgres",
          "redis"
        ],
        "title": "ReadinessResponse"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "type"
        ],
        "title": "ValidationIssue"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
