  "components": {
    "schemas": {
      "CaseInput": {
        "properties": {
          "resolution": {
            "type": "string",
            "enum": [
              "reviewed",
              "escalated",
              "false_positive"
            ],
            "title": "Resolution"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resolution"
        ],
        "title": "CaseInput"
      },
      "CaseView": {
        "properties": {
          "resolution": {
            "type": "string",
            "enum": [
              "reviewed",
              "escalated",
              "false_positive"
            ],
            "title": "Resolution"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resolution",
          "id"
        ],
        "title": "CaseView"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "EventView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "student_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "student_id",
          "category",
          "severity",
          "action",
          "created_at"
        ],
        "title": "EventView"
      },
      "FlagInput": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled",
          "expected_revision"
        ],
        "title": "FlagInput"
      },
      "FlagView": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "enabled",
          "revision"
        ],
        "title": "FlagView"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "module": {
            "type": "string",
            "const": "infrastructure",
            "title": "Module",
            "default": "infrastructure"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "Pending": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "lesson",
              "exercise",
              "rag"
            ],
            "title": "Kind"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "content_id": {
            "type": "string",
            "format": "uuid",
            "title": "Content Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "review_path": {
            "type": "string",
            "title": "Review Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "id",
          "content_id",
          "version",
          "review_path"
        ],
        "title": "Pending"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "module": {
            "type": "string",
            "const": "infrastructure",
            "title": "Module",
            "default": "infrastructure"
          },
          "postgres": {
            "type": "boolean",
            "title": "Postgres"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service",
          "postgres",
          "redis"
        ],
        "title": "ReadinessResponse"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "type"
        ],
        "title": "ValidationIssue"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
