  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "module": {
            "type": "string",
            "const": "infrastructure",
            "title": "Module",
            "default": "infrastructure"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "ProgressSummary": {
        "properties": {
          "student_id": {
            "type": "string",
            "format": "uuid",
            "title": "Student Id"
          },
          "competences_acquises": {
            "type": "integer",
            "title": "Competences Acquises"
          },
          "competences_a_retravailler": {
            "type": "integer",
            "title": "Competences A Retravailler"
          },
          "competences_en_apprentissage": {
            "type": "integer",
            "title": "Competences En Apprentissage"
          },
          "minutes_session_estimees": {
            "type": "integer",
            "title": "Minutes Session Estimees"
          },
          "tentatives_terminees": {
            "type": "integer",
            "title": "Tentatives Terminees"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Chaque séance permet d'avancer à son rythme."
          }
        },
        "type": "object",
        "required": [
          "student_id",
          "competences_acquises",
          "competences_a_retravailler",
          "competences_en_apprentissage",
          "minutes_session_estimees",
          "tentatives_terminees"
        ],
        "title": "ProgressSummary"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "module": {
            "type": "string",
            "const": "infrastructure",
            "title": "Module",
            "default": "infrastructure"
          },
          "postgres": {
            "type": "boolean",
            "title": "Postgres"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service",
          "postgres",
          "redis"
        ],
        "title": "ReadinessResponse"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "type"
        ],
        "title": "ValidationIssue"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
