{
  "openapi": "3.1.0",
  "info": {
    "title": "ÉDUCAPILOTE — tutor-service",
    "description": "Capitaine Savoir : sept niveaux 0–6, sources validées et messages pédagogiques contrôlés.",
    "version": "0.6.0"
  },
  "servers": [
    {
      "url": "/services/tutor-service"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "infrastructure"
        ],
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "infrastructure"
        ],
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Dépendance indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/turns": {
      "post": {
        "summary": "Turn",
        "operationId": "turn_turns_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TutorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TutorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Session invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Accès interdit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Requête trop volumineuse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation refusée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Limite atteinte",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Dépendance indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/attempts/{attempt_id}/history": {
      "get": {
        "summary": "History",
        "operationId": "history_attempts__attempt_id__history_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Attempt Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TutorResponse"
                  },
                  "title": "Response History Attempts  Attempt Id  History Get"
                }
              }
            }
          },
          "401": {
            "description": "Session invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Accès interdit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Requête trop volumineuse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation refusée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Limite atteinte",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Dépendance indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "module": {
            "type": "string",
            "const": "infrastructure",
            "title": "Module",
            "default": "infrastructure"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "module": {
            "type": "string",
            "const": "infrastructure",
            "title": "Module",
            "default": "infrastructure"
          },
          "postgres": {
            "type": "boolean",
            "title": "Postgres"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service",
          "postgres",
          "redis"
        ],
        "title": "ReadinessResponse"
      },
      "TutorRequest": {
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid",
            "title": "Attempt Id"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "message": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1,
            "format": "password",
            "title": "Message",
            "writeOnly": true
          },
          "plus_aide": {
            "type": "boolean",
            "title": "Plus Aide",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt_id",
          "request_id",
          "message"
        ],
        "title": "TutorRequest"
      },
      "TutorResponse": {
        "properties": {
          "message_pedagogique": {
            "type": "string",
            "title": "Message Pedagogique"
          },
          "type": {
            "type": "string",
            "enum": [
              "questionnement",
              "indice",
              "methode_partielle",
              "refus_socratique",
              "indisponible",
              "protection"
            ],
            "title": "Type"
          },
          "niveau_aide": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Niveau Aide"
          },
          "aide_max": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Aide Max",
            "default": 6
          },
          "question_suivante": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Suivante"
          },
          "erreur_detectee": {
            "type": "string",
            "enum": [
              "non_determinee",
              "comprehension",
              "organisation",
              "verification"
            ],
            "title": "Erreur Detectee"
          },
          "action_recommandee": {
            "type": "string",
            "enum": [
              "reformuler",
              "identifier",
              "representer",
              "relier",
              "decomposer",
              "verifier",
              "amorcer",
              "reessayer",
              "demander_adulte"
            ],
            "title": "Action Recommandee"
          },
          "safety_status": {
            "type": "string",
            "enum": [
              "safe",
              "blocked",
              "fallback"
            ],
            "title": "Safety Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_pedagogique",
          "type",
          "niveau_aide",
          "question_suivante",
          "erreur_detectee",
          "action_recommandee",
          "safety_status"
        ],
        "title": "TutorResponse"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "type"
        ],
        "title": "ValidationIssue"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
